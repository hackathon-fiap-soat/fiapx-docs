{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hackathon-fiap-soat/fiapx-docs/contracts/artifacts-cleaned.v1.schema.json",
  "title": "ArtifactsCleaned v1",
  "description": "Resposta (video-processor → video-api): artefatos parciais apagados (fim da compensação do passo ProcessVideo).",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "ArtifactsCleaned"
        },
        "version": {
          "const": 1
        },
        "payload": {
          "type": "object",
          "description": "Payload de ArtifactsCleaned.",
          "required": [
            "deleted_objects"
          ],
          "properties": {
            "deleted_objects": {
              "type": "integer",
              "minimum": 0,
              "description": "Quantidade de objetos apagados (0 se não havia nada)."
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}

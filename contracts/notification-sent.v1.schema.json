{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hackathon-fiap-soat/fiapx-docs/contracts/notification-sent.v1.schema.json",
  "title": "NotificationSent v1",
  "description": "Resposta (notification → video-api): e-mail enviado (ou já enviado antes, em caso de mensagem duplicada).",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "NotificationSent"
        },
        "version": {
          "const": 1
        },
        "payload": {
          "type": "object",
          "description": "Payload de NotificationSent.",
          "required": [
            "channel"
          ],
          "properties": {
            "channel": {
              "type": "string",
              "enum": [
                "EMAIL"
              ],
              "description": "Canal usado no envio."
            },
            "provider_message_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "description": "Id retornado pelo provedor (Message-ID devolvido pelo servidor SMTP). Opcional."
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}

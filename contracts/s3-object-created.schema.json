{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hackathon-fiap-soat/fiapx-docs/contracts/s3-object-created.schema.json",
  "title": "S3 ObjectCreated (subconjunto)",
  "description": "Subconjunto da notificação de evento do Amazon S3 (s3:ObjectCreated:*) entregue na fila video-uploaded e lido pelo saga-consumer. O formato é da AWS, não usa o envelope do FIAP X; só os campos abaixo são lidos e os demais são ignorados.",
  "type": "object",
  "required": [
    "Records"
  ],
  "properties": {
    "Records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "eventSource",
          "eventName",
          "s3"
        ],
        "properties": {
          "eventSource": {
            "type": "string",
            "const": "aws:s3"
          },
          "eventName": {
            "type": "string",
            "pattern": "^ObjectCreated:",
            "description": "Ex.: ObjectCreated:Post."
          },
          "eventTime": {
            "type": "string",
            "format": "date-time"
          },
          "s3": {
            "type": "object",
            "required": [
              "bucket",
              "object"
            ],
            "properties": {
              "bucket": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 63
                  }
                }
              },
              "object": {
                "type": "object",
                "required": [
                  "key",
                  "size"
                ],
                "properties": {
                  "key": {
                    "type": "string",
                    "pattern": "^uploads/.+",
                    "description": "Chave do objeto, no formato uploads/{video_id}.{ext}. O S3 envia a chave codificada como URL; decodificar antes de usar. A extensão não é restringida aqui: quem valida é o passo ValidateUpload da SAGA."
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Tamanho do objeto em bytes."
                  },
                  "eTag": {
                    "type": "string"
                  },
                  "sequencer": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

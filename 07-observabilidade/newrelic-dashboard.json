                "query": "SELECT max(aws.sqs.ApproximateNumberOfMessagesVisible) FROM Metric WHERE aws.sqs.QueueName LIKE 'fiapx-prod-%' AND aws.sqs.QueueName NOT LIKE '%-dlq%' FACET aws.sqs.QueueName TIMESERIES 5 minutes SINCE 6 hours ago"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false

                "query": "SELECT sum(aws.lambda.Invocations) AS 'Invocações', sum(aws.lambda.Errors) AS 'Erros', average(aws.lambda.Duration) AS 'Duração média (ms)', sum(aws.lambda.Throttles) AS 'Throttles' FROM Metric WHERE aws.lambda.FunctionName LIKE 'fiapx-prod-%' FACET aws.lambda.FunctionName SINCE 1 day ago"

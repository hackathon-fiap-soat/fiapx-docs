                "query": "SELECT average(aws.apigateway.Latency) AS 'Latência média', max(aws.apigateway.Latency) AS 'Latência máxima', average(aws.apigateway.IntegrationLatency) AS 'Integração média' FROM Metric WHERE aws.apigateway.ApiId IS NOT NULL TIMESERIES 5 minutes SINCE 6 hours ago"
              }
            ],
            "platformOptions": {

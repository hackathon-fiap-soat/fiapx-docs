            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  0
                ],
                "query": "SELECT latest(podsAvailable) AS 'Pods disponíveis', latest(podsDesired) AS 'Pods desejados' FROM K8sDeploymentSample WHERE clusterName LIKE 'fiapx-prod%' AND deploymentName LIKE '%video-processor%' TIMESERIES 1 minute SINCE 6 hours ago"
              },
              {
                "accountIds": [
                  0
                ],
                "query": "SELECT max(aws.sqs.ApproximateNumberOfMessagesVisible) AS 'Mensagens na processing-commands' FROM Metric WHERE aws.sqs.QueueName = 'fiapx-prod-processing-commands' TIMESERIES 1 minute SINCE 6 hours ago"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            },
            "legend": {
              "enabled": true
            },

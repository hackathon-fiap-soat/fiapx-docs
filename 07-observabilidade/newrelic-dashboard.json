{
  "name": "FIAP X — Processamento de vídeos",
  "description": "Saúde da SAGA de processamento, filas SQS, worker (KEDA), API Gateway e video-api. Substitua accountIds [0] pelo id da conta New Relic antes de importar.",
  "permissions": "PUBLIC_READ_WRITE",
  "pages": [
    {
      "name": "Processamento",
      "description": "Status dos vídeos, throughput, tempo de processamento, falhas e sagas presas.",
      "widgets": [
        {
          "title": "Como usar",
          "layout": {
            "column": 1,
            "row": 1,
            "width": 4,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.markdown"
          },
          "rawConfiguration": {
            "text": "**FIAP X — Processamento de vídeos**\n\nEventos customizados: `VideoSagaTransition` (video-api) e `VideoProcessed` (video-processor). Atributos comuns: `video_id`, `saga_id`, `correlation_id`.\n\nFilas via CloudWatch Metric Streams (`aws.sqs.*`). Worker via `K8sDeploymentSample`.\n\nDocumentação: `fiapx-docs/07-observabilidade/observabilidade.md`."
          }
        },
        {
          "title": "Vídeos por status (hoje)",
          "layout": {
            "column": 5,
            "row": 1,
            "width": 4,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.pie"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  0
                ],
                "query": "SELECT count(*) AS 'Vídeos' FROM (SELECT latest(video_status) AS status FROM VideoSagaTransition WHERE video_id IS NOT NULL FACET video_id LIMIT MAX) FACET status SINCE today"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            },
            "facet": {
              "showOtherSeries": false
            }
          }
        },
        {
          "title": "Taxa de falha (24 h)",
          "layout": {
            "column": 9,
            "row": 1,
            "width": 4,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  0
                ],
                "query": "SELECT percentage(count(*), WHERE to_state = 'COMPENSATED') AS 'Falhas (%)' FROM VideoSagaTransition WHERE to_state IN ('COMPLETED', 'COMPENSATED') SINCE 1 day ago"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            },
            "thresholds": [
              {
                "alertSeverity": "WARNING",
                "value": 5
              },
              {
                "alertSeverity": "CRITICAL",
                "value": 10
              }
            ]
          }
        },
        {
          "title": "Throughput de uploads",
          "layout": {
            "column": 1,
            "row": 4,
            "width": 6,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  0
                ],
                "query": "SELECT count(*) AS 'Envios solicitados' FROM Transaction WHERE appName = 'fiapx-video-api' AND request.method = 'POST' AND request.uri = '/api/videos' TIMESERIES 5 minutes SINCE 6 hours ago"
              },
              {
                "accountIds": [
                  0
                ],
                "query": "SELECT count(*) AS 'Uploads recebidos (saga iniciada)' FROM VideoSagaTransition WHERE to_state = 'STARTED' TIMESERIES 5 minutes SINCE 6 hours ago"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            },
            "legend": {
              "enabled": true
            },
            "yAxisLeft": {
              "zero": true
            },
            "facet": {
              "showOtherSeries": false
            }
          }
        },
        {
          "title": "Tempo de processamento p50/p95 (s)",
          "layout": {
            "column": 7,
            "row": 4,
            "width": 6,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  0
                ],
                "query": "SELECT percentile(duration_ms / 1000, 50, 95) FROM VideoProcessed TIMESERIES 15 minutes SINCE 1 day ago"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            },
            "legend": {
              "enabled": true
            },
            "yAxisLeft": {
              "zero": true
            },
            "facet": {
              "showOtherSeries": false
            }
          }
        },
        {
          "title": "Taxa de falha ao longo do tempo (%)",
          "layout": {
            "column": 1,
            "row": 7,
            "width": 6,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  0
                ],
                "query": "SELECT percentage(count(*), WHERE to_state = 'COMPENSATED') AS 'Falhas (%)' FROM VideoSagaTransition WHERE to_state IN ('COMPLETED', 'COMPENSATED') TIMESERIES 15 minutes SINCE 1 day ago"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            },
            "legend": {
              "enabled": true
            },
            "yAxisLeft": {
              "zero": true
            },
            "facet": {
              "showOtherSeries": false
